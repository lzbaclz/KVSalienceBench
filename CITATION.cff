cff-version: 1.2.0
message: "Cite this artifact and the accepted D2AI 2026 workshop manuscript."
title: "Mining Attention Dynamics: Auditing KV-Saliency Prediction in LLMs"
authors:
  - family-names: Li
    given-names: Ziqing
  - family-names: Guo
    given-names: Jiawei
  - family-names: Tang
    given-names: Kaicheng
  - family-names: Chen
